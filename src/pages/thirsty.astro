<BaseLayout title="Thirsty | Me Likey Wine" description="A shortlist of group wine picks, Santa Rosa vineyards, and Sonoma County tasting options for the Me Likey Wine trip.">
	<section class="texture px-5 py-16 lg:px-8">
		<div class="mx-auto max-w-6xl">
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-wine">Thirsty</p>
			<div class="mt-3 grid gap-6 lg:grid-cols-[1fr_20rem] lg:items-end">
				<h1 class="serif max-w-4xl text-5xl font-semibold leading-none text-ink sm:text-6xl">Group picks plus top vineyards nearby.</h1>
				<p class="text-sm leading-6 text-ink/62">The first six are group-requested stops. Ratings are public visitor snapshots and should be rechecked before booking.</p>
			</div>
		</div>
	</section>

	<section class="px-5 pb-16 lg:px-8">
		<div class="mx-auto max-w-6xl">
			<div class="grid gap-4">
				{vineyards.map((vineyard, index) => (
					<article class="tasting-card grid gap-5 rounded-md p-5 md:grid-cols-[3.25rem_1fr_auto] md:items-center">
						<div class="serif flex h-12 w-12 items-center justify-center rounded-full bg-wine text-2xl font-semibold text-cream">{index + 1}</div>
						<div>
							<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
								<h2 class="serif text-3xl font-semibold text-ink">{vineyard.name}</h2>
								<span class="rounded-sm bg-vine/10 px-2 py-1 text-xs font-bold uppercase tracking-[0.14em] text-vine-dark">{vineyard.area}</span>
								{vineyard.groupPick && <span class="rounded-sm bg-wine px-2 py-1 text-xs font-bold uppercase tracking-[0.14em] text-cream">Group Pick</span>}
							</div>
							<p class="mt-2 max-w-3xl leading-7 text-ink/68">{vineyard.description}</p>
						</div>
						<div class="flex items-center justify-between gap-4 md:min-w-48 md:justify-end">
							<div class="text-right">
								<p class="text-xs font-bold uppercase tracking-[0.16em] text-ink/50">Rating</p>
								<p class="serif text-3xl font-semibold text-wine">{vineyard.rating}</p>
							</div>
							<a href={vineyard.url} target="_blank" rel="noreferrer" class="rounded-sm border border-wine px-4 py-3 text-sm font-bold uppercase tracking-[0.14em] text-wine transition hover:bg-wine hover:text-white">Website</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
