---
import BaseLayout from '../layouts/BaseLayout.astro';

const airbnbUrl = 'https://www.airbnb.com/rooms/625427669108406706?viralityEntryPoint=1&s=76&source_impression_id=p3_1785087587_P3eRqQv_Z6ig90Zr';
---

<BaseLayout title="Lodging | Me Likey Wine">
	<section class="px-5 py-16 lg:px-8">
		<div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr]">
			<div>
				<p class="text-sm font-bold uppercase tracking-[0.18em] text-wine">Lodging</p>
				<h1 class="serif mt-3 text-5xl font-semibold text-ink sm:text-6xl">Home base in Santa Rosa.</h1>
				<p class="mt-5 text-lg leading-8 text-ink/70">The group stay is a Wine Country Villa in Santa Rosa with a heated pool and hot tub. Add the exact address, check-in code, room assignments, and grocery plan once the booking details are finalized.</p>
				<a href={airbnbUrl} target="_blank" rel="noreferrer" class="mt-7 inline-flex rounded-sm bg-wine px-5 py-3 text-sm font-bold uppercase tracking-[0.14em] text-white transition hover:bg-wine/85">Open Airbnb</a>
			</div>
			<div class="tasting-card rounded-md p-6">
				<dl class="grid gap-5 sm:grid-cols-2">
					<div>
						<dt class="text-sm font-bold uppercase tracking-[0.16em] text-vine">Listing</dt>
						<dd class="mt-2 text-ink/62">Wine Country Villa | Heated Pool | Hot Tub</dd>
					</div>
					<div>
						<dt class="text-sm font-bold uppercase tracking-[0.16em] text-vine">Check-In</dt>
						<dd class="mt-2 text-ink/62">TBD</dd>
					</div>
					<div>
						<dt class="text-sm font-bold uppercase tracking-[0.16em] text-vine">Address</dt>
						<dd class="mt-2 text-ink/62">TBD</dd>
					</div>
					<div>
						<dt class="text-sm font-bold uppercase tracking-[0.16em] text-vine">Amenities</dt>
						<dd class="mt-2 text-ink/62">Heated pool, hot tub</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>
</BaseLayout>
