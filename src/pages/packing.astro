---
import BaseLayout from '../layouts/BaseLayout.astro';

const packing = ['Reservation confirmations', 'Comfortable vineyard shoes', 'Layers for cool evenings', 'Sunscreen and sunglasses', 'Water bottle', 'Room for bottle purchases'];
---

<BaseLayout title="Packing | Me Likey Wine">
	<section class="px-5 py-16 lg:px-8">
		<div class="mx-auto max-w-6xl">
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-wine">Packing</p>
			<h1 class="serif mt-3 text-5xl font-semibold text-ink sm:text-6xl">Bring the sensible things. Buy the fun things.</h1>
			<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{packing.map((item) => (
					<div class="tasting-card rounded-md p-5">
						<p class="font-semibold text-vine-dark">{item}</p>
					</div>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
