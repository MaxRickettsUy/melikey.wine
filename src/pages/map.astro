---
import BaseLayout from '../layouts/BaseLayout.astro';

const stops = ['Charles M. Schulz - Sonoma County Airport', 'Wine Country Villa', 'Morning tasting', 'Lunch', 'Afternoon tasting', 'Dinner'];

const links = [
	{
		label: 'Airport',
		title: 'Charles M. Schulz - Sonoma County Airport',
		detail: 'STS is at 2200 Airport Boulevard, Santa Rosa, CA 95403.',
		href: 'https://sonomacountyairport.org/',
	},
	{
		label: 'Transportation',
		title: 'Destination Drivers',
		detail: 'Designated drivers for your own car or rental, with Sonoma pickup options.',
		href: 'https://destinationdrivers.com/destinations/sonoma/',
	},
	{
		label: 'Lodging',
		title: 'Wine Country Villa',
		detail: 'Santa Rosa Airbnb with heated pool and hot tub.',
		href: 'https://www.airbnb.com/rooms/625427669108406706?viralityEntryPoint=1&s=76&source_impression_id=p3_1785087587_P3eRqQv_Z6ig90Zr',
	},
];
---

<BaseLayout title="Map | Me Likey Wine">
	<section class="px-5 py-16 lg:px-8">
		<div class="mx-auto max-w-6xl">
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-wine">Map</p>
			<h1 class="serif mt-3 text-5xl font-semibold text-ink sm:text-6xl">Travel and route sketch</h1>
			<div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1fr]">
				<div class="tasting-card rounded-md p-6">
					<div class="relative ml-3 space-y-8">
						<div class="route-line absolute bottom-4 left-[0.46rem] top-4 w-0.5"></div>
						{stops.map((stop, index) => (
							<div class="relative flex gap-4">
								<div class="z-10 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-wine ring-4 ring-cream"></div>
								<div>
									<p class="text-xs font-bold uppercase tracking-[0.16em] text-vine">Stop {index + 1}</p>
									<p class="mt-1 text-lg font-semibold">{stop}</p>
								</div>
							</div>
						))}
					</div>
				</div>
				<div class="texture min-h-80 rounded-md border border-ink/10 p-6">
					<p class="text-sm font-bold uppercase tracking-[0.18em] text-wine">Logistics Links</p>
					<div class="mt-6 space-y-4">
						{links.map((item) => (
							<a href={item.href} target="_blank" rel="noreferrer" class="block rounded-md border border-ink/10 bg-cream/60 p-4 transition hover:border-wine/40">
								<p class="text-xs font-bold uppercase tracking-[0.16em] text-vine">{item.label}</p>
								<h2 class="serif mt-1 text-2xl font-semibold">{item.title}</h2>
								<p class="mt-2 text-sm leading-6 text-ink/66">{item.detail}</p>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
